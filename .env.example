# MSAL Configuration (client-side, no secrets)
NEXT_PUBLIC_MSAL_CLIENT_ID=""
NEXT_PUBLIC_MSAL_AUTHORITY="https://login.microsoftonline.com/common"
NEXT_PUBLIC_MSAL_REDIRECT_URI="http://localhost:3000"

# AI Feature Toggle (client-side, set to "true" to enable AI bar)
# NEXT_PUBLIC_AI_ENABLED="true"

# Azure OpenAI (server-side only — NEVER prefix with NEXT_PUBLIC_)
# AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
# AZURE_OPENAI_KEY="your-key"
# AZURE_OPENAI_DEPLOYMENT="your-deployment"

# Prisma
DATABASE_URL="file:./db.sqlite"
